---
import Logo from './Logo.astro';
import Icon from './Icon.astro';

interface Props { current?: 'map' | 'sap' | 'paths' | 'about' }
const { current } = Astro.props;
const nav = [
  { id: 'map', href: '/#map', label: 'Map' },
  { id: 'sap', href: '/sap/', label: 'SAP in practice' },
  { id: 'paths', href: '/#paths', label: 'Prep paths' },
  { id: 'about', href: '/about/', label: 'About' },
] as const;
---
<header class="topbar">
  <div class="wrap topbar-inner">
    <a class="brand" href="/" aria-label="Decision Atlas, home">
      <Logo size={28} />
      <span class="brand-name">Decision Atlas</span>
    </a>
    <nav class="topnav" aria-label="Main">
      {nav.map((n) => (
        <a href={n.href} aria-current={current === n.id ? 'page' : undefined}>{n.label}</a>
      ))}
    </nav>
    <div class="top-actions">
      <button type="button" class="search-trigger" data-open-search aria-haspopup="dialog">
        <Icon name="search" />
        <span class="search-trigger-label">Search</span>
        <kbd class="kbd" data-shortcut>⌘K</kbd>
      </button>
      <button type="button" class="icon-btn" data-open-settings aria-haspopup="dialog" aria-label="Reading settings" title="Reading settings">
        <Icon name="type" />
      </button>
      <details class="menu">
        <summary class="icon-btn" aria-label="Menu"><Icon name="menu" /></summary>
        <div class="menu-panel card">
          {nav.map((n) => (
            <a href={n.href} aria-current={current === n.id ? 'page' : undefined}>{n.label}</a>
          ))}
        </div>
      </details>
    </div>
  </div>
  <div class="read-progress" aria-hidden="true"><span></span></div>
</header>

<style>
  .topbar {
    position: sticky; top: 0; z-index: 40;
    background: color-mix(in srgb, var(--canvas) 86%, transparent);
    backdrop-filter: saturate(1.4) blur(12px);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid var(--rule);
  }
  .topbar-inner { display: flex; align-items: center; gap: 1.5rem; height: 3.75rem; }
  .brand { display: inline-flex; align-items: center; gap: 0.6rem; text-decoration: none; color: var(--ink); flex: none; }
  .brand-name { font-weight: 800; font-size: 1.08rem; letter-spacing: -0.02em; }
  .topnav { display: flex; gap: 0.25rem; }
  .topnav a {
    padding: 0.45rem 0.7rem; border-radius: 8px; text-decoration: none;
    color: var(--ink-2); font-weight: 600; font-size: 0.92rem;
    transition: background var(--dur) var(--ease), color var(--dur) var(--ease);
  }
  .topnav a:hover { background: var(--surface-3); color: var(--ink); }
  .topnav a[aria-current='page'] { color: var(--ink); background: var(--surface-3); }
  .top-actions { margin-left: auto; display: flex; align-items: center; gap: 0.35rem; }
  .search-trigger {
    display: inline-flex; align-items: center; gap: 0.55rem;
    height: 2.5rem; padding: 0 0.6rem 0 0.75rem; min-width: 13rem;
    border-radius: 10px; border: 1px solid var(--rule); background: var(--surface);
    color: var(--muted); font-size: 0.92rem; font-weight: 500;
    transition: border-color var(--dur) var(--ease);
  }
  .search-trigger:hover { border-color: var(--rule-2); color: var(--ink-2); }
  .search-trigger :global(svg) { width: 1.1rem; height: 1.1rem; }
  .search-trigger-label { flex: 1; text-align: left; }
  .kbd {
    font-family: var(--font-mono); font-size: 0.72rem; color: var(--muted);
    border: 1px solid var(--rule); border-bottom-width: 2px; border-radius: 6px; padding: 0.1rem 0.4rem;
  }
  .menu { position: relative; display: none; }
  .menu summary { list-style: none; }
  .menu summary::-webkit-details-marker { display: none; }
  .menu-panel {
    position: absolute; right: 0; top: calc(100% + 8px); z-index: 50; min-width: 12rem;
    display: grid; padding: 0.4rem; box-shadow: var(--shadow);
  }
  .menu-panel a { padding: 0.6rem 0.75rem; border-radius: 8px; text-decoration: none; font-weight: 600; }
  .menu-panel a:hover { background: var(--surface-3); }
  .read-progress { position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; pointer-events: none; }
  .read-progress span { display: block; height: 100%; width: 0; background: var(--c, var(--ink)); transform-origin: left; }

  @media (max-width: 880px) {
    .topnav { display: none; }
    .menu { display: block; }
    .search-trigger { min-width: 0; }
  }
  @media (max-width: 560px) {
    .topbar-inner { gap: 0.75rem; }
    .search-trigger { width: 2.5rem; padding: 0; justify-content: center; border-color: transparent; background: transparent; color: var(--ink-2); }
    .search-trigger-label, .kbd { display: none; }
    .brand-name { font-size: 1rem; }
  }
  :global(html[data-focus='on']) .topnav { opacity: 0.55; }
</style>
