---
import Icon from './Icon.astro';

const themes = [
  { id: 'auto', label: 'Auto', a: '#ffffff', b: '#161a21' },
  { id: 'light', label: 'Light', a: '#ffffff', b: '#ffffff' },
  { id: 'sepia', label: 'Sepia', a: '#fbf7ef', b: '#fbf7ef' },
  { id: 'dark', label: 'Dark', a: '#161a21', b: '#161a21' },
];
const fonts = [
  { id: 'sans', label: 'Sans', note: 'Overpass', family: 'var(--font-ui)' },
  { id: 'serif', label: 'Serif', note: 'Literata', family: "'Literata Variable', Georgia, serif" },
  { id: 'easy', label: 'Easy read', note: 'Atkinson Hyperlegible', family: "'Atkinson Hyperlegible Next Variable', system-ui, sans-serif" },
];
---
<dialog class="sheet" id="settings" aria-labelledby="settings-title">
  <form method="dialog" class="sheet-inner" data-settings-form>
    <header class="sheet-head">
      <div>
        <h2 id="settings-title">Reading settings</h2>
        <p class="muted">Saved on this device. Changes apply as you choose them.</p>
      </div>
      <button class="icon-btn" value="close" aria-label="Close reading settings"><Icon name="close" /></button>
    </header>

    <fieldset class="field">
      <legend>Theme</legend>
      <div class="theme-grid">
        {themes.map((t) => (
          <label class="theme-opt">
            <input type="radio" name="theme" value={t.id} />
            <span class="swatch" aria-hidden="true" style={`--a:${t.a};--b:${t.b}`}><span>Aa</span></span>
            <span class="opt-label">{t.label}</span>
          </label>
        ))}
      </div>
    </fieldset>

    <fieldset class="field">
      <legend>Text size</legend>
      <div class="size-row">
        <span class="size-a" aria-hidden="true">A</span>
        <input class="range" type="range" name="size" min="1" max="5" step="1" aria-label="Text size" />
        <span class="size-a size-a-big" aria-hidden="true">A</span>
      </div>
    </fieldset>

    <fieldset class="field">
      <legend>Typeface for reading</legend>
      <div class="font-grid">
        {fonts.map((f) => (
          <label class="font-opt">
            <input type="radio" name="font" value={f.id} />
            <span class="font-sample" style={`font-family:${f.family}`} aria-hidden="true">Aa</span>
            <span class="opt-label">{f.label}</span>
            <span class="font-note">{f.note}</span>
          </label>
        ))}
      </div>
    </fieldset>

    <fieldset class="field">
      <legend>Line spacing</legend>
      <div class="seg">
        <label><input type="radio" name="spacing" value="compact" />Compact</label>
        <label><input type="radio" name="spacing" value="comfortable" />Comfortable</label>
        <label><input type="radio" name="spacing" value="relaxed" />Relaxed</label>
      </div>
    </fieldset>

    <fieldset class="field">
      <legend>Line length</legend>
      <div class="seg">
        <label><input type="radio" name="width" value="narrow" />Narrow</label>
        <label><input type="radio" name="width" value="medium" />Medium</label>
        <label><input type="radio" name="width" value="wide" />Wide</label>
      </div>
    </fieldset>

    <fieldset class="field">
      <legend>Start each topic at</legend>
      <div class="seg">
        <label><input type="radio" name="depth" value="1" />Gist</label>
        <label><input type="radio" name="depth" value="2" />How it works</label>
        <label><input type="radio" name="depth" value="3" />Deep dive</label>
      </div>
      <p class="hint muted">Deeper levels stay one click away whichever you choose.</p>
    </fieldset>

    <div class="field toggles">
      <label class="toggle-row">
        <span class="toggle-text"><strong>Focus mode</strong><span class="muted">Hide the line map beside the text</span></span>
        <span class="switch"><input type="checkbox" name="focus" /><span></span></span>
      </label>
      <label class="toggle-row">
        <span class="toggle-text"><strong>Reduce motion</strong><span class="muted">Turn off animations and smooth scrolling</span></span>
        <span class="switch"><input type="checkbox" name="motion" /><span></span></span>
      </label>
    </div>

    <div class="preview">
      <p class="eyebrow">Preview</p>
      <p class="prose preview-text">Safety stock covers the surprises while you wait for a delivery. It grows with the square root of lead time, not with lead time itself.</p>
    </div>

    <footer class="sheet-foot">
      <button type="button" class="btn btn-ghost btn-sm" data-reset><Icon name="reset" />Reset to defaults</button>
      <button class="btn btn-primary btn-sm" value="close">Done</button>
    </footer>
  </form>
</dialog>

<script>
  import { getPrefs, setPrefs, resetPrefs, type Prefs } from '../scripts/prefs';

  const dlg = document.getElementById('settings') as HTMLDialogElement | null;
  const form = dlg?.querySelector<HTMLFormElement>('[data-settings-form]');

  function sync(p: Prefs = getPrefs()) {
    if (!form) return;
    for (const name of ['theme', 'font', 'spacing', 'width', 'depth'] as const) {
      const input = form.querySelector<HTMLInputElement>(`input[name="${name}"][value="${p[name]}"]`);
      if (input) input.checked = true;
    }
    const size = form.querySelector<HTMLInputElement>('input[name="size"]');
    if (size) { size.value = p.size; size.style.setProperty('--pct', `${((Number(p.size) - 1) / 4) * 100}%`); }
    const focus = form.querySelector<HTMLInputElement>('input[name="focus"]');
    if (focus) focus.checked = p.focus;
    const motion = form.querySelector<HTMLInputElement>('input[name="motion"]');
    if (motion) motion.checked = p.motion === 'reduce';
  }

  if (dlg && form) {
    document.querySelectorAll<HTMLElement>('[data-open-settings]').forEach((btn) =>
      btn.addEventListener('click', () => { sync(); dlg.showModal(); }),
    );
    form.addEventListener('input', (e) => {
      const t = e.target as HTMLInputElement;
      switch (t.name) {
        case 'theme': setPrefs({ theme: t.value as Prefs['theme'] }); break;
        case 'size':
          setPrefs({ size: t.value as Prefs['size'] });
          t.style.setProperty('--pct', `${((Number(t.value) - 1) / 4) * 100}%`);
          break;
        case 'font': setPrefs({ font: t.value as Prefs['font'] }); break;
        case 'spacing': setPrefs({ spacing: t.value as Prefs['spacing'] }); break;
        case 'width': setPrefs({ width: t.value as Prefs['width'] }); break;
        case 'depth': setPrefs({ depth: t.value as Prefs['depth'] }); break;
        case 'focus': setPrefs({ focus: t.checked }); break;
        case 'motion': setPrefs({ motion: t.checked ? 'reduce' : 'auto' }); break;
      }
    });
    form.querySelector('[data-reset]')?.addEventListener('click', () => { resetPrefs(); sync(); });
    // A click on the backdrop lands on the dialog element itself.
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    document.addEventListener('atlas:prefs', () => { if (dlg.open) sync(); });
  }
</script>

<style>
  .sheet {
    position: fixed; inset: 0 0 0 auto; margin: 0; padding: 0;
    width: min(440px, 100vw); height: 100dvh; max-height: 100dvh; max-width: 100vw;
    border: 0; border-left: 1px solid var(--rule); background: var(--surface); box-shadow: var(--shadow-lg);
  }
  .sheet-inner { display: flex; flex-direction: column; gap: 1.35rem; min-height: 100%; padding: 1.25rem 1.5rem 1.5rem; }
  .sheet-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; }
  .sheet-head h2 { font-size: 1.25rem; font-weight: 800; }
  .sheet-head p { font-size: 0.875rem; margin-top: 0.25rem; }
  .field { border: 0; margin: 0; padding: 0; display: grid; gap: 0.6rem; }
  .field legend { padding: 0; margin-bottom: 0.6rem; font-weight: 700; font-size: 0.875rem; }
  .hint { font-size: 0.8rem; }

  .theme-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.5rem; }
  .theme-opt, .font-opt {
    position: relative; display: grid; justify-items: center; gap: 0.35rem; padding: 0.6rem 0.4rem 0.55rem;
    border: 1px solid var(--rule); border-radius: 12px; cursor: pointer; text-align: center;
    transition: border-color var(--dur) var(--ease), background var(--dur) var(--ease);
  }
  .theme-opt:hover, .font-opt:hover { border-color: var(--rule-2); background: var(--surface-2); }
  .theme-opt input, .font-opt input { position: absolute; opacity: 0; pointer-events: none; }
  .theme-opt:has(input:checked), .font-opt:has(input:checked) { border-color: var(--ink); box-shadow: inset 0 0 0 1px var(--ink); }
  .theme-opt:has(input:focus-visible), .font-opt:has(input:focus-visible) { outline: 2px solid var(--focus); outline-offset: 2px; }
  .swatch {
    display: grid; place-items: center; width: 2.6rem; height: 2.6rem; border-radius: 50%;
    background: linear-gradient(135deg, var(--a) 50%, var(--b) 50%); border: 1px solid var(--rule-2);
    font-weight: 700; font-size: 0.8rem;
  }
  .swatch span { color: #6b7280; mix-blend-mode: difference; filter: invert(1); }
  .opt-label { font-weight: 650; font-size: 0.82rem; }

  .size-row { display: flex; align-items: center; gap: 0.85rem; }
  .size-a { font-weight: 700; font-size: 0.85rem; color: var(--ink-2); }
  .size-a-big { font-size: 1.3rem; }
  .range { flex: 1; }

  .font-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.5rem; }
  .font-sample { font-size: 1.6rem; line-height: 1.1; font-weight: 500; }
  .font-note { font-size: 0.7rem; color: var(--muted); line-height: 1.2; }

  .toggles { gap: 0.25rem; }
  .toggle-row { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.55rem 0; cursor: pointer; }
  .toggle-text { display: grid; gap: 0.1rem; }
  .toggle-text strong { font-size: 0.92rem; }
  .toggle-text .muted { font-size: 0.8rem; }

  .preview { border: 1px dashed var(--rule-2); border-radius: 12px; padding: 0.85rem 1rem; display: grid; gap: 0.4rem; }
  .preview-text { max-width: none; }

  .sheet-foot { margin-top: auto; display: flex; justify-content: space-between; gap: 0.75rem; padding-top: 0.5rem; }
  .sheet-foot :global(svg) { width: 1rem; height: 1rem; }

  @media (max-width: 560px) {
    .sheet {
      inset: auto 0 0 0; width: 100vw; height: auto; max-height: 88dvh;
      border-left: 0; border-top: 1px solid var(--rule); border-radius: 20px 20px 0 0;
    }
    .sheet-inner { padding: 1.1rem 1rem 1.25rem; gap: 1.1rem; }
    .font-note { display: none; }
  }
</style>
