---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
import { lines, stations, lineById } from '../data/atlas';

const entries = await getCollection('stations');
const built = new Map(entries.map((e) => [e.id, e]));

const index = [...stations.values()].map((st) => {
  const line = lineById.get(st.line)!;
  const entry = built.get(st.slug);
  return {
    t: st.name,
    s: entry?.data.summary ?? st.summary,
    l: line.name,
    c: line.code,
    tone: line.tone,
    u: entry ? `/${st.line}/${st.slug}/` : `/${st.line}/#${st.slug}`,
    b: Boolean(entry),
    k: entry ? entry.data.keywords.join(' ') : '',
  };
});
const lineIndex = lines.map((l) => ({ t: l.name, s: l.tagline, c: l.code, tone: l.tone, u: `/${l.id}/` }));
const payload = JSON.stringify({ stations: index, lines: lineIndex }).replace(/</g, '\\u003c');
---
<dialog class="palette" id="search" aria-label="Search the atlas">
  <div class="palette-inner">
    <div class="palette-input">
      <Icon name="search" />
      <input
        type="text"
        id="search-input"
        placeholder="Search topics, formulas, jargon…"
        autocomplete="off"
        spellcheck="false"
        role="combobox"
        aria-expanded="true"
        aria-controls="search-results"
        aria-autocomplete="list"
      />
      <button type="button" class="kbd esc" data-close-search aria-label="Close search">Esc</button>
    </div>
    <p class="palette-hint muted" id="search-hint">Lines</p>
    <ul id="search-results" role="listbox" aria-labelledby="search-hint"></ul>
    <p class="palette-empty muted" hidden>Nothing matches yet. Try “safety stock”, “MRP” or “MAPE”.</p>
    <footer class="palette-foot muted">
      <span><kbd class="kbd">↑</kbd> <kbd class="kbd">↓</kbd> move</span>
      <span><kbd class="kbd">↵</kbd> open</span>
      <span class="palette-foot-note">Topics marked “Soon” open their line</span>
    </footer>
  </div>
  <script is:inline type="application/json" id="search-index" set:html={payload}></script>
</dialog>

<script>
  type Entry = { t: string; s: string; l?: string; c: string; tone: string; u: string; b?: boolean; k?: string };

  const dlg = document.getElementById('search') as HTMLDialogElement | null;
  const input = document.getElementById('search-input') as HTMLInputElement | null;
  const list = document.getElementById('search-results') as HTMLUListElement | null;
  const hint = document.getElementById('search-hint');
  const empty = dlg?.querySelector<HTMLElement>('.palette-empty');
  const raw = document.getElementById('search-index')?.textContent ?? '{"stations":[],"lines":[]}';
  const data = JSON.parse(raw) as { stations: Entry[]; lines: Entry[] };
  let active = 0;
  let current: Entry[] = [];

  const norm = (v: string) => v.toLowerCase().normalize('NFKD').replace(/[̀-ͯ]/g, '');

  function score(e: Entry, q: string, tokens: string[]): number {
    const t = norm(e.t), k = norm(e.k ?? ''), s = norm(e.s), l = norm(e.l ?? '');
    const hay = `${t} ${k} ${s} ${l} ${norm(e.c)}`;
    if (!tokens.every((tok) => hay.includes(tok))) return 0;
    let sc = 0;
    if (t.startsWith(q)) sc += 100; else if (t.includes(q)) sc += 60;
    if (k.includes(q)) sc += 45;
    if (s.includes(q)) sc += 15;
    for (const tok of tokens) if (t.split(/[^a-z0-9&]+/).some((w) => w.startsWith(tok))) sc += 12;
    if (e.b) sc += 8;
    return sc;
  }

  function render() {
    if (!list || !input) return;
    const q = norm(input.value.trim());
    const tokens = q.split(/\s+/).filter(Boolean);
    if (!q) {
      current = data.lines;
      if (hint) hint.textContent = 'Lines';
    } else {
      current = data.stations
        .map((e) => ({ e, sc: score(e, q, tokens) }))
        .filter((x) => x.sc > 0)
        .sort((a, b) => b.sc - a.sc)
        .slice(0, 12)
        .map((x) => x.e);
      if (hint) hint.textContent = current.length ? 'Topics' : '';
    }
    active = 0;
    list.replaceChildren(
      ...current.map((e, i) => {
        const li = document.createElement('li');
        li.id = `sr-${i}`;
        li.setAttribute('role', 'option');
        li.dataset.url = e.u;
        li.setAttribute('aria-selected', String(i === active));
        const badge = document.createElement('span');
        badge.className = 'badge badge-sm';
        badge.dataset.tone = e.tone;
        badge.textContent = e.c;
        const text = document.createElement('span');
        text.className = 'sr-text';
        const title = document.createElement('span');
        title.className = 'sr-title';
        title.textContent = e.t;
        const sub = document.createElement('span');
        sub.className = 'sr-sub';
        sub.textContent = e.s;
        text.append(title, sub);
        li.append(badge, text);
        if (e.b === false) {
          const tag = document.createElement('span');
          tag.className = 'sr-tag';
          tag.textContent = 'Soon';
          li.append(tag);
        }
        li.addEventListener('pointermove', () => setActive(i));
        li.addEventListener('click', () => go(i));
        return li;
      }),
    );
    if (empty) empty.hidden = current.length > 0;
    input.setAttribute('aria-activedescendant', current.length ? 'sr-0' : '');
  }

  function setActive(i: number) {
    if (!list || !input || !current.length) return;
    active = (i + current.length) % current.length;
    list.querySelectorAll('[role="option"]').forEach((el, j) => el.setAttribute('aria-selected', String(j === active)));
    input.setAttribute('aria-activedescendant', `sr-${active}`);
    list.querySelector(`#sr-${active}`)?.scrollIntoView({ block: 'nearest' });
  }

  function go(i: number) {
    const e = current[i];
    if (!e) return;
    dlg?.close();
    window.location.href = e.u;
  }

  function open() {
    if (!dlg || !input) return;
    if (!dlg.open) dlg.showModal();
    input.value = '';
    render();
    input.focus();
  }

  if (dlg && input) {
    const isMac = /Mac|iPhone|iPad/.test(navigator.platform || navigator.userAgent);
    document.querySelectorAll<HTMLElement>('[data-shortcut]').forEach((k) => (k.textContent = isMac ? '⌘K' : 'Ctrl K'));
    document.querySelectorAll<HTMLElement>('[data-open-search]').forEach((b) => b.addEventListener('click', open));
    dlg.querySelector('[data-close-search]')?.addEventListener('click', () => dlg.close());
    input.addEventListener('input', render);
    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') { e.preventDefault(); setActive(active + 1); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); setActive(active - 1); }
      else if (e.key === 'Enter') { e.preventDefault(); go(active); }
    });
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    document.addEventListener('keydown', (e) => {
      const target = e.target as HTMLElement;
      const typing = target.closest('input, textarea, select, [contenteditable="true"]');
      if ((e.key === 'k' || e.key === 'K') && (e.metaKey || e.ctrlKey)) { e.preventDefault(); open(); }
      else if (e.key === '/' && !typing && !dlg.open) { e.preventDefault(); open(); }
    });
  }
</script>

<style>
  .palette {
    margin: 10vh auto auto; padding: 0; width: min(640px, calc(100vw - 24px)); max-height: 76vh;
    border: 1px solid var(--rule); border-radius: 16px; background: var(--surface); box-shadow: var(--shadow-lg); overflow: hidden;
  }
  .palette-inner { display: flex; flex-direction: column; max-height: 76vh; }
  .palette-input { display: flex; align-items: center; gap: 0.7rem; padding: 0.9rem 1rem; border-bottom: 1px solid var(--rule); }
  .palette-input :global(svg) { width: 1.25rem; height: 1.25rem; color: var(--muted); flex: none; }
  .palette-input input { flex: 1; min-width: 0; border: 0; outline: 0; background: transparent; font-size: 1.1rem; font-weight: 500; }
  .palette-input input::placeholder { color: var(--muted); }
  .esc { cursor: pointer; background: var(--surface); }
  .palette-hint { padding: 0.75rem 1.1rem 0.25rem; font-size: 0.75rem; font-family: var(--font-mono); text-transform: uppercase; letter-spacing: 0.08em; }
  .palette-hint:empty { display: none; }
  #search-results { list-style: none; margin: 0; padding: 0.25rem 0.5rem 0.5rem; overflow-y: auto; }
  #search-results :global([role='option']) {
    display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 0.8rem;
    padding: 0.6rem 0.65rem; border-radius: 10px; cursor: pointer;
  }
  #search-results :global([aria-selected='true']) { background: var(--surface-3); }
  #search-results :global(.sr-text) { display: grid; min-width: 0; }
  #search-results :global(.sr-title) { font-weight: 650; }
  #search-results :global(.sr-sub) { font-size: 0.85rem; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  #search-results :global(.sr-tag) { font-size: 0.72rem; font-weight: 600; color: var(--muted); border: 1px solid var(--rule); border-radius: 999px; padding: 0.1rem 0.5rem; }
  .palette-empty { padding: 1rem 1.25rem 1.25rem; }
  .palette-foot { display: flex; gap: 1.1rem; padding: 0.6rem 1rem; border-top: 1px solid var(--rule); font-size: 0.78rem; background: var(--surface-2); }
  .palette-foot-note { margin-left: auto; }
  .kbd { font-family: var(--font-mono); font-size: 0.72rem; color: var(--muted); border: 1px solid var(--rule); border-bottom-width: 2px; border-radius: 6px; padding: 0.1rem 0.4rem; }
  @media (max-width: 560px) {
    .palette { margin-top: 12px; max-height: 84vh; }
    .palette-inner { max-height: 84vh; }
    .palette-foot { display: none; }
  }
</style>
