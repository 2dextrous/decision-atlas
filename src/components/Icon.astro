---
interface Props {
  name: 'search' | 'type' | 'menu' | 'close' | 'arrow-right' | 'arrow-left' | 'check' | 'chevron-down' | 'copy' | 'clock' | 'layers' | 'external' | 'shuffle' | 'reset' | 'map';
