---
import Logo from './Logo.astro';
const year = 2026;
---
<footer class="site-foot">
  <div class="wrap foot-inner">
    <div class="foot-brand">
      <a class="foot-logo" href="/"><Logo size={24} /><span>Decision Atlas</span></a>
      <p class="muted">Supply chain decisions explained for placements, from a two-minute gist to interview depth.</p>
    </div>
    <nav class="foot-links" aria-label="Footer">
      <a href="/about/">About</a>
      <a href="/about/#how-this-was-made">How this was made</a>
      <a href="/#paths">Prep paths</a>
      <a href="https://github.com/2dextrous" rel="noopener">GitHub</a>
    </nav>
    <p class="foot-legal muted">
      © {year} Dhiraj Badshe<span class="sep"><span class="sr-only">, </span></span>Text licensed CC BY-NC 4.0, code MIT<span class="sep"><span class="sr-only">, </span></span>Pages marked “Draft” are still being checked; corrections are welcome.
    </p>
  </div>
</footer>

<style>
  .site-foot { margin-top: 6rem; border-top: 1px solid var(--rule); background: var(--surface); }
  .foot-inner { display: grid; grid-template-columns: 1.4fr 1fr; gap: 1.5rem 3rem; padding-block: 2.5rem 2rem; }
  .foot-logo { display: inline-flex; align-items: center; gap: 0.55rem; font-weight: 800; text-decoration: none; letter-spacing: -0.02em; }
  .foot-brand p { margin-top: 0.6rem; max-width: 46ch; font-size: 0.95rem; }
  .foot-links { display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; align-content: start; justify-content: end; }
  .foot-links a { color: var(--ink-2); text-decoration: none; font-weight: 600; font-size: 0.92rem; }
  .foot-links a:hover { color: var(--ink); text-decoration: underline; }
  .foot-legal { grid-column: 1 / -1; font-size: 0.82rem; border-top: 1px solid var(--rule); padding-top: 1.25rem; }
  @media (max-width: 720px) {
    .foot-inner { grid-template-columns: 1fr; }
    .foot-links { justify-content: start; }
  }
</style>
