---
import { stations, type Line } from '../data/atlas';

interface Props {
  line: Line;
  built: Set<string>;
}
const { line, built } = Astro.props;
const ready = line.stops.filter((s) => built.has(s.slug)).length;
---
<article class="line-card card" data-tone={line.tone} id={`line-${line.id}`}>
  <header class="lc-head">
    <a class="lc-title" href={`/${line.id}/`}>
      <span class="badge">{line.code}</span>
      <span class="lc-name">{line.name}</span>
    </a>
    <span class="lc-progress muted" data-line-progress data-slugs={line.stops.map((s) => s.slug).join(',')}>{line.stops.length} stops</span>
  </header>
  <p class="lc-tagline">{line.tagline}</p>
  <ol class="stops">
    {line.stops.map((stop) => {
      const st = stations.get(stop.slug)!;
      const isBuilt = built.has(stop.slug);
      const interchange = st.lines.length > 1;
      const href = isBuilt ? `/${st.line}/${stop.slug}/` : `/${line.id}/#${stop.slug}`;
      return (
        <li class:list={['stop', { 'is-planned': !isBuilt }]} data-slug={stop.slug}>
          <a class="stop-link" href={href} title={stop.summary}>
            <span class:list={['dot', { 'is-planned': !isBuilt && !interchange, 'is-interchange': interchange }]} aria-hidden="true"></span>
            <span class="stop-name">{stop.label}</span>
            {isBuilt ? (
              <span class="meter" data-levels="3" title="Gist, how it works and deep dive"><i></i><i></i><i></i></span>
            ) : (
              <span class="sr-only">(being written)</span>
            )}
          </a>
        </li>
      );
    })}
  </ol>
  <footer class="lc-foot">
    <a class="lc-more" href={`/${line.id}/`}>{ready > 0 ? `${ready} ready to read` : 'See the line'}<span aria-hidden="true"> →</span></a>
  </footer>
</article>

<style>
  .line-card { display: flex; flex-direction: column; padding: 1.1rem 1.1rem 0.9rem; min-width: 0; transition: border-color var(--dur) var(--ease), box-shadow var(--dur) var(--ease); }
  .line-card:hover { border-color: var(--rule-2); box-shadow: var(--shadow); }
  .lc-head { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; }
  .lc-title { display: inline-flex; align-items: center; gap: 0.6rem; text-decoration: none; min-width: 0; }
  .lc-name { font-weight: 800; font-size: 1.08rem; letter-spacing: -0.015em; }
  .lc-title:hover .lc-name { text-decoration: underline; text-decoration-color: var(--c); text-decoration-thickness: 2px; text-underline-offset: 0.25em; }
  .lc-progress { font-size: 0.78rem; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .lc-tagline { margin: 0.55rem 0 0.75rem; color: var(--ink-2); font-size: 0.92rem; line-height: 1.45; }

  .stops { position: relative; list-style: none; margin: 0; padding: 0; }
  .stops::before {
    content: ''; position: absolute; left: calc(0.625rem - 2px); top: 0.95rem; bottom: 0.95rem;
    width: 4px; border-radius: 2px; background: var(--c);
  }
  .stop-link {
    display: grid; grid-template-columns: 1.25rem 1fr auto; align-items: center; gap: 0.55rem;
    padding: 0.32rem 0.45rem 0.32rem 0; border-radius: 8px; text-decoration: none; color: var(--ink);
    font-size: 0.92rem; line-height: 1.3;
    transition: background var(--dur) var(--ease);
  }
  .stop-link:hover { background: var(--surface-2); }
  .stop-link:hover .dot { transform: scale(1.15); }
  .stop.is-planned .stop-name { color: var(--muted); }
  .stop.is-done .stop-name::after { content: ' ✓'; color: var(--muted); font-weight: 700; }
  .lc-foot { margin-top: auto; padding-top: 0.7rem; }
  .lc-more { font-size: 0.85rem; font-weight: 650; color: var(--ink-2); text-decoration: none; }
  .lc-more:hover { color: var(--ink); text-decoration: underline; }
</style>
